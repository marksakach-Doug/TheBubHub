function ff(secs){for(let i=0;i<secs*30;i++)step(1/30)}

function step(dt){
  if(!S.go)return;
  S.t+=dt;const p=S.pot,c=S.pan,L=S.L;
  if(S.phase==='wash'&&S.rinse&&S.basin==='full'){
      const speeds=[[6,.02],[14,.12],[30,.4]];
      const rate=speeds[S.rinse-1];
      const efficiency=(100-S.waterDirt)/100;
      const removed=rate[0]*efficiency*(S.grit/100)*dt*4;
      S.grit=Math.max(0,S.grit-removed);
      S.waterDirt=Math.min(100,S.waterDirt+removed*3.5);
      S.spill+=rate[1]*dt;
  }
  const cDry=c.rich<=0; // ghee is the pan's buffer: an empty pan heats fast and runs far hotter
  c.temp+=(25+c.dial*(cDry?34:21.5)-c.temp)*(cDry?.45:.22)*dt;
  if(c.temp>=240){spoil('PAN FIRE',1);c.temp=150;c.dial=0}
  if(c.spice){
      const t=c.temp;

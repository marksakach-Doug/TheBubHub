<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Dal Tadka</title>
<style>
:root{--bg:#f4ead8;--panel:#fffaf0;--ink:#2a1d12;--line:#d6c4a4;--dim:#7a6a58;--acc:#c2410c;--good:#2e7d32;--bad:#c62828;--trk:#ebdfc6;--wat:#0288d1;--grit:#8d5524;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#120E0A;--panel:#1A140F;--ink:#F0E6D2;--line:#3A2C21;--dim:#A89B8D;--acc:#FF9900;--good:#4CAF50;--bad:#F44336;--trk:#0A0806;--wat:#29b6f6;--grit:#b8793a}}
:root[data-theme="dark"]{--bg:#120E0A;--panel:#1A140F;--ink:#F0E6D2;--line:#3A2C21;--dim:#A89B8D;--acc:#FF9900;--good:#4CAF50;--bad:#F44336;--trk:#0A0806;--wat:#29b6f6;--grit:#b8793a}
html{scroll-padding-top:env(safe-area-inset-top,0px);-webkit-text-size-adjust:100%;height:100%}
*{box-sizing:border-box}
body{margin:0;min-height:100%;background:var(--bg);color:var(--ink);font:15px/1.4 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;overflow-x:hidden}
main{max-width:640px;margin:0 auto;padding:8px;display:flex;flex-direction:column;gap:8px}
.pn{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:10px}
h1,h2{margin:0 0 6px;font:700 16px Georgia,serif;color:var(--acc);display:flex;align-items:center}
button{font:700 14px ui-monospace,Menlo,monospace;color:var(--ink);background:var(--trk);border:1px solid var(--line);border-radius:6px;padding:12px 6px;width:100%;cursor:pointer;touch-action:manipulation;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
button:active{transform:scale(.97);border-color:var(--acc)}
button:disabled{opacity:.4}
button small{display:block;font-weight:400;font-size:11px;opacity:.85}
.row{display:flex;gap:6px;margin-top:6px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:2px 12px;margin-bottom:6px}
.hide{display:none!important}.off{opacity:.4;pointer-events:none}
.dim{color:var(--dim)}
.mr{margin:2px 0}.mr label{display:flex;justify-content:space-between;font:12px ui-monospace,monospace;color:var(--dim);align-items:center}
.mt{position:relative;height:12px;background:var(--trk);border:1px solid var(--line);border-radius:6px;overflow:hidden}
.mt i{position:absolute;top:0;bottom:0;background:var(--good);opacity:.4}
.mt b{position:absolute;left:0;top:0;bottom:0;background:var(--acc);width:0}
.mt.w b{background:var(--bad)}
.mt.bl b{background:var(--wat)}.mt.bl i{background:var(--wat);opacity:.3}
.mt.br b{background:var(--grit)}
.top{display:flex;justify-content:space-between;align-items:center;position:sticky;top:env(safe-area-inset-top,8px);z-index:100;box-shadow:0 4px 12px rgba(0,0,0,.1)}
#clk{font:700 26px ui-monospace,monospace}
#hint{font-size:13px;border-left:4px solid var(--acc)}
#al{min-height:22px;font-weight:700;text-align:center}
#log div{font:12px ui-monospace,monospace;color:var(--dim);padding:2px 0}
.lc{margin-top:8px;text-align:left;font-family:system-ui,sans-serif;font-weight:400}
.ev{display:flex;justify-content:space-between;align-items:center;gap:8px;font:14px ui-monospace,monospace;border-bottom:1px dashed var(--line);padding:6px 0}
.big{padding:16px;background:var(--acc);color:#fff;border-color:var(--acc)}
.blu{background:var(--wat);color:#fff;border-color:var(--wat)}
.ok{background:var(--good);color:#fff;border-color:var(--good)}
.wb{background:var(--wat);color:#fff;border-color:var(--wat);padding:10px 2px}
.wb span{display:block;font-size:18px;letter-spacing:-2px}
.pulse{animation:pl 1s infinite}
@keyframes pl{50%{box-shadow:0 0 0 7px rgba(2,136,209,.35)}}
.bsn{display:flex;gap:10px;align-items:center}.bsn .grid{flex:1;grid-template-columns:1fr;margin:0}
#bowl{width:104px;height:104px;flex:none}
#sw{transform-origin:50px 50px;transform-box:view-box}
.spin{animation:sp linear infinite}@keyframes sp{to{transform:rotate(360deg)}}
.sl{margin-top:8px}.sl label{display:flex;justify-content:space-between;font:700 13px ui-monospace,monospace}
input[type=range]{width:100%;height:30px;margin:2px 0;accent-color:var(--acc)}
.sc{display:flex;justify-content:space-between;font:11px ui-monospace,monospace;color:var(--dim)}
.tabs{display:flex;gap:4px}.tabs button{padding:8px 2px;font-size:12px}.tabs .on{background:var(--acc);color:#fff;border-color:var(--acc)}
.lbr{display:flex;gap:8px;padding:4px 0;border-bottom:1px dashed var(--line);font:13px ui-monospace,monospace}.lbr b{flex:1}
.gr{font:700 64px Georgia,serif;line-height:1}
.cmp{display:flex;gap:8px;align-items:flex-start;padding:8px 0;border-bottom:1px dashed var(--line)}
.cmp .ic{font:700 18px ui-monospace,monospace;width:22px;text-align:center}
.cmp .bar{height:6px;background:var(--trk);border-radius:3px;margin:4px 0;overflow:hidden}.cmp .bar b{display:block;height:100%}
input[type=text]{font:16px system-ui;padding:10px;border:1px solid var(--line);border-radius:6px;background:var(--trk);color:var(--ink);width:100%}
textarea{width:100%;font:12px ui-monospace,monospace;background:var(--trk);color:var(--ink);border:1px solid var(--line);border-radius:6px;padding:6px}
.vz{flex:none}
.bub{transform-box:fill-box;transform-origin:center;fill:rgba(255,255,255,.75);animation:bu var(--bd,1.6s) ease-out infinite}
@keyframes bu{0%{transform:scale(.2);opacity:0}40%{opacity:1}100%{transform:scale(1.3);opacity:0}}
#cbu .bub{fill:rgba(255,230,140,.9)}
#pfl,#pfl2,#cfl,#cfl2{animation:fk .16s infinite alternate}@keyframes fk{to{opacity:.75}}
.mt b{z-index:1}
.mt i,.mt.bl i{opacity:1;z-index:2;background:repeating-linear-gradient(135deg,rgba(46,160,67,.5) 0 3px,rgba(46,160,67,.12) 3px 6px);border-left:2px solid #35d058;border-right:2px solid #35d058;box-shadow:0 0 0 1px rgba(0,0,0,.35)}
main{gap:6px;padding:6px}.pn{padding:8px}h2{font-size:14px}h1,h2{margin-bottom:4px}
.top{padding:6px 10px;flex-wrap:wrap}#clk{font-size:22px}#al{min-height:18px;font-size:13px;width:100%;text-align:left}
#hint{padding:6px 8px;font-size:12px}
.mr{margin:1px 0}.mr label{font-size:10.5px}.mr svg{width:12px!important;height:12px!important;margin-right:2px!important;vertical-align:-2px!important}
.mt{height:10px}.bsn .grid{gap:0}
#potv{width:84px;height:84px}#panv{width:100px;height:77px}
.sl{margin-top:6px}.sl label{display:flex;justify-content:space-between;align-items:center;font:700 12.5px ui-monospace,monospace;margin-bottom:4px}
.bn{display:grid;grid-template-columns:repeat(11,minmax(0,1fr));gap:3px;border-radius:8px}
.bn button{padding:0;height:46px;font-size:13px;border-radius:5px}
.bn .lo{background:color-mix(in srgb,var(--acc) 28%,var(--trk));border-color:color-mix(in srgb,var(--acc) 50%,var(--line))}
.bn .cur{background:var(--acc);color:#fff;border-color:var(--acc)}
.row{margin-top:4px}.row button{padding:8px 4px}.big{padding:12px}
.ph-wash .ck{display:none!important}.ph-cook .wo{display:none!important}.ph-cook button small{display:none}
*{-webkit-tap-highlight-color:transparent}
html,body{touch-action:manipulation}
svg{user-select:none;-webkit-user-select:none;-webkit-touch-callout:none;cursor:default}
.rb{touch-action:none}
.mr label{font-size:11px}
.vw{flex:none;text-align:center}.vw .cap{font:11px ui-monospace,monospace;color:var(--dim);margin-top:2px}
.hl{font:700 13px ui-monospace,monospace;margin:10px 0 4px}.hl span{font-weight:400;font-size:12px;color:var(--dim)}
.dir{margin:0 0 6px;padding-left:20px;font-size:12.5px;line-height:1.35;color:var(--dim)}.dir li{padding:1px 0}.dir li.now{color:var(--ink);font-weight:700}
.lc{display:flex;align-items:center;gap:10px;margin-top:6px}.lc .sw{flex:none;width:34px;height:34px;border-radius:50%;border:2px solid var(--line)}.lc .lt{flex:1;line-height:1.35}.lc .go{flex:none;background:var(--acc);color:#fff;border-radius:6px;padding:9px 10px;font-size:13px}
#stars{display:flex;justify-content:center;gap:4px;margin:4px 0}#stars i{display:block;width:46px;height:46px}
#stars svg{width:100%;height:100%;fill:var(--trk);stroke:var(--line);stroke-width:1;stroke-linejoin:round;transform-origin:50% 50%}
#stars i.on svg{fill:#f2b01e;stroke:#c98a00;animation:pop .5s cubic-bezier(.2,1.6,.4,1)}
@keyframes pop{0%{transform:scale(2.1);filter:brightness(2.2) drop-shadow(0 0 8px #ffe08a)}100%{transform:scale(1);filter:none}}
#verd{opacity:0;transition:opacity .5s}#verd.show{opacity:1}
@media (prefers-reduced-motion:reduce){#stars i.on svg{animation:none}#verd{transition:none}}
div.lc.locked{opacity:.65;border:2px solid var(--line);border-radius:8px;padding:10px 8px;background:var(--trk)}.lc.locked .go{background:var(--line);color:var(--dim)}
.lc.sel{outline:3px solid var(--acc);outline-offset:-1px}.lc[data-p]:not(.sel) .go{opacity:.45}
.mt u{position:absolute;top:0;bottom:0;width:3px;margin-left:-1px;background:var(--ink);z-index:3}
.row .on{background:var(--acc);color:#fff;border-color:var(--acc)}
a.kofi{display:flex;width:fit-content;align-items:center;gap:7px;min-height:38px;margin:18px auto 8px;padding:6px 16px;border-radius:19px;background:#e5e7eb;border:2px solid #c7cbd1;color:#2f343a;font:700 13px ui-monospace,monospace;text-decoration:none;box-shadow:0 2px 0 #c7cbd1;transition:transform .12s,box-shadow .12s}
a.kofi:hover{filter:brightness(1.05)}a.kofi:active{transform:translateY(2px);box-shadow:none}
a.kofi svg{width:18px;height:18px;flex:none;fill:none;stroke:#2a1a05;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.sec{border:2px solid #c98a00;background:color-mix(in srgb,#f2b01e 18%,transparent);border-radius:8px;padding:10px;margin-bottom:10px;font-size:14px}
.guide{animation:gd 1s ease-in-out infinite;position:relative;z-index:1}@keyframes gd{0%,100%{box-shadow:0 0 0 0 transparent}50%{box-shadow:0 0 0 6px var(--acc)}}
button.lk{width:auto;padding:6px 12px;font-size:12.5px}.tb{display:flex;justify-content:space-between;align-items:center;gap:8px}
.chips{display:flex;flex-wrap:wrap;gap:4px;list-style:none;margin:0 0 6px;padding:0}.chips li{border:1px solid var(--line);border-radius:12px;padding:2px 9px;font-size:12px;color:var(--dim)}.chips li.now{background:var(--acc);border-color:var(--acc);color:#fff;font-weight:700}
.info p,.info li{font-size:13px;line-height:1.45;margin:4px 0}.info ul{margin:4px 0;padding-left:18px}.info details{border-top:1px solid var(--line)}
.tbl{width:100%;border-collapse:collapse;font-size:12.5px}.tbl td,.tbl th{padding:3px 4px;text-align:left;border-bottom:1px solid var(--line)}
summary{cursor:pointer;font:700 13px ui-monospace,monospace;padding:10px 0;color:var(--dim)}
.flash{animation:fl .5s ease-in-out 3}@keyframes fl{50%{box-shadow:0 0 0 5px var(--acc)}}
</style>
</head>
<body>
<main id="mn" class="ph-wash">
<section id="setup" class="pn">
  <div class="tb"><h1 style="margin:0">Dal Tadka</h1><button data-i="1" class="lk">Details</button></div>
  <div style="margin:4px 0 2px">The people are hungry. Make the best dal you can.</div>
  <div class="dim" style="margin:0 0 4px">Wash → Boil → Tadka → Serve</div>
  <h2 id="pick_h" style="margin-top:10px">Pick a lentil</h2>
  <div class="dim" id="pick_s"></div>
  <div id="lents" style="margin-top:4px"></div>
  <h2 style="margin-top:14px">Leaderboard</h2>
  <div class="tabs" id="lbt"></div>
  <div id="lb"></div>
</section>

<section id="play" class="hide" style="display:flex;flex-direction:column;gap:8px">
  <div class="pn top"><b id="ln"></b><span id="clk">0:00.0</span><div id="al"></div></div>
  <div class="pn" id="hint"></div>
  <div class="pn wo" id="basp">
    <h2 id="h_basin">Wash basin</h2>
    <div class="bsn">
      <div class="vw"><svg id="bowl" viewBox="0 0 100 100" aria-label="Wash bowl, top view">
        <circle cx="50" cy="50" r="48" fill="#8a7a66"/>
        <circle id="bw" cx="50" cy="50" r="41" fill="#8fd3f4"/>
        <g id="sw"><g id="gn"></g><g id="gt"></g></g>
        <circle cx="50" cy="50" r="45" fill="none" stroke="#b9a98f" stroke-width="5"/>
      </svg><div class="cap">view only</div></div>
      <div id="basin" class="grid"></div>
    </div>
    <div class="hl">HOLD to wash</div>
    <div class="row" style="margin-top:0">
      <button class="rb wb" data-l="0" id="b_gen" disabled><span>›</span>GENTLE<small>slow, safe</small></button>
      <button class="rb wb" data-l="1" id="b_std" disabled><span>››</span>STEADY<small>balanced</small></button>
      <button class="rb wb" data-l="2" id="b_rck" disabled><span>›››</span>FAST<small>quick, spills dal</small></button>
    </div>
    <button data-a="fill" id="b_fill" class="blu" style="margin-top:8px;padding:14px">CHANGE WATER <small>costs 2s</small></button>
    <button data-a="wdone" class="ok" style="margin-top:12px;padding:14px">✓ DONE WASHING</button>
  </div>
  <div class="pn" id="potp">
    <h2 id="h_pot" style="margin:0 0 6px">Dal pot</h2>
    <div class="bsn"><svg id="potv" class="vz" viewBox="0 0 100 100" width="104" height="104" aria-label="Pot, top view"><path id="pfl" fill="#4aa8ff"/><path id="pfl2" fill="#ffd54a"/><circle cx="50" cy="50" r="36" fill="#7b7f86"/><circle cx="50" cy="50" r="31" fill="#3d3a37"/><clipPath id="pcp"><circle id="pcc" cx="50" cy="50" r="29"/></clipPath><circle id="plq" cx="50" cy="50" r="29" fill="#8fd3f4"/><g clip-path="url(#pcp)"><g id="pbl"></g><g id="pb"></g><g id="pbu"></g></g><circle id="pfo" cx="50" cy="50" r="28" fill="none" stroke="#fff" style="stroke-width:0;opacity:0"/><circle id="pst" cx="50" cy="50" r="29" fill="none" stroke="#2e1a0c" stroke-width="3" stroke-dasharray="7 10" style="opacity:0"/><circle cx="50" cy="50" r="34" fill="none" stroke="#9ea3ab" stroke-width="4"/></svg><div id="potm" class="grid"></div></div>
    <div class="sl"><label><span id="pl">Burner</span><span id="pdial"></span></label><div class="bn" id="pbn" role="group" aria-label="Pot burner level"></div></div>
    <div class="row"><button data-a="unwater" id="b_wm" class="blu">− WATER<small>1 cup</small></button><button data-a="water" id="b_wp" class="blu">+ WATER<small>1 cup</small></button><button data-a="stir" class="ck">STIR<small>unsticks</small></button></div>
    <button data-a="add2" id="b_add2" class="big ck hide" style="margin-top:8px"></button>
  </div>
  <div class="pn">
    <h2 id="h_pan" style="margin:0 0 6px">Tadka pan</h2>
    <ul class="chips" id="dir"><li>Ghee 2-3</li><li>Heat</li><li>Spice</li><li>Cool + serve</li></ul>
    <div class="bsn ck"><svg id="panv" class="vz" viewBox="0 0 130 100" width="122" height="94" aria-label="Tadka pan, top view"><path id="cfl" fill="#4aa8ff"/><path id="cfl2" fill="#ffd54a"/><rect x="78" y="45" width="48" height="10" rx="5" fill="#5b5b60"/><circle cx="46" cy="50" r="36" fill="#6b6e75"/><circle id="cpan" cx="46" cy="50" r="31" fill="#2f2c2a"/><clipPath id="ccp"><circle id="ccc" cx="46" cy="50" r="0"/></clipPath><circle id="cgh" cx="46" cy="50" r="0" fill="#f2c230" opacity=".9"/><g clip-path="url(#ccp)"><g id="cbu"></g></g><g id="csp" style="opacity:0;transition:opacity .4s"><g id="csd"></g><g id="chb"></g><g id="cch"></g></g><circle id="csm" cx="46" cy="50" r="30" fill="#bbb" style="opacity:0"/><circle cx="46" cy="50" r="34" fill="none" stroke="#8c9097" stroke-width="3"/></svg><div id="panm" class="grid"></div></div>
    <div class="sl"><label><span id="cl">Burner</span><span id="cdial"></span></label><div class="bn" id="cbn" role="group" aria-label="Pan burner level"></div></div>
    <div class="row"><button data-a="ghee" id="b_ghee">ADD GHEE</button><button data-a="spice" id="b_spice" class="ck">ADD SPICE</button></div>
  </div>
  <button class="big" id="serve" data-a="serve">SERVE</button>
  
</section>

<section id="res" class="pn hide"></section>
<section id="info" class="pn hide info"></section>
<a class="kofi" id="foot" href="https://ko-fi.com/markdoug" target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><path d="M3 11h18a9 9 0 0 1-18 0z"/><path d="M8 7c-1-1.2 1-2 0-3.5M12 7c-1-1.2 1-2 0-3.5M16 7c-1-1.2 1-2 0-3.5"/></svg>Buy the creator some lentils</a>
</main>
<script>
const $=i=>document.getElementById(i),cl=(v,a,b)=>Math.min(b,Math.max(a,v));
const LENT={
 moong:{n:'Moong',look:'Small yellow split lentils',d:'Quick and forgiving.',need:25,stick:.03,w:[3.5,4.8],par:55},
 masoor:{n:'Masoor',look:'Red-orange split lentils',d:'Cooks fastest, uses little water.',need:16,stick:.04,w:[3,4.2],par:45},
 chana:{n:'Chana',look:'Split chickpeas, large and golden',d:'Slow and thirsty.',need:50,stick:.02,w:[4.5,6],par:90},
 urad:{n:'Urad',look:'Small black lentils',d:'Sticky and demands attention.',need:34,stick:.085,w:[3.5,4.8],par:70},
 toor:{n:'Toor',look:'Split pigeon peas, bright yellow',d:'The everyday classic. Patient and thirsty.',need:38,stick:.05,w:[4,5.4],par:75},
 double:{n:'Double dal',tab:'Double',double:1,look:'Two lentils, one pot',d:'Mix any two.'}};
const API='https://script.google.com/macros/s/AKfycbwhy40Gk_QPoVz-jEwe-I72_rqbudw_QeLxZcGz7e2BMH3kIYS0AWkBiRulJl-CfU5jyA/exec'; // Apps Script web app URL (see README)
const RAW={moong:[110,150,60],masoor:[196,120,60],chana:[200,165,95],urad:[40,38,36],toor:[214,176,66]},COOK={moong:[233,196,60],masoor:[232,146,58],chana:[212,154,44],urad:[150,132,92],toor:[236,182,50]};
const mixv=(a,b,t)=>a.map((v,i)=>Math.round(v+(b[i]-v)*t)),rgbs=a=>`rgb(${a})`;
function flame(id,id2,cx,cy,r,len,t){
 const mk=(L,w)=>{if(L<.6)return '';let d='';const p=(a,R)=>`${(cx+Math.cos(a)*R).toFixed(1)} ${(cy+Math.sin(a)*R).toFixed(1)}`;for(let i=0;i<14;i++){const a=i*6.2832/14;d+=`M${p(a-w,r-3)}Q${p(a-w*.8,r+L*.5)} ${p(a,r+L)}Q${p(a+w*.8,r+L*.5)} ${p(a+w,r-3)}Z`}return d};
 $(id).setAttribute('d',mk(len,.2));$(id).setAttribute('fill','rgb('+[74+181*t,168-62*t,255-235*t].map(Math.round)+')');$(id2).setAttribute('d',mk(len*.55,.12));
}
(function(){let s=11,r=()=>(s=(s*16807)%2147483647)/2147483647;
 const pt=(cx,cy,R)=>{const a=r()*6.283,d=Math.sqrt(r())*R;return [cx+Math.cos(a)*d,cy+Math.sin(a)*d]};
 const el=(n,cx,cy,R,rx,ry)=>{let o='';for(let i=0;i<n;i++){const [x,y]=pt(cx,cy,R);o+=`<ellipse cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" rx="${rx}" ry="${ry}" transform="rotate(${(r()*180).toFixed(0)} ${x.toFixed(1)} ${y.toFixed(1)})"/>`}return o};
 const bu=(n,cx,cy,R)=>{let o='';for(let i=0;i<n;i++){const [x,y]=pt(cx,cy,R);o+=`<circle class="bub" cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${(1.8+r()*2.4).toFixed(1)}" style="animation-delay:-${(r()*2).toFixed(2)}s"/>`}return o};
 let bl='';for(let i=0;i<9;i++){const [x,y]=pt(50,50,20);bl+=`<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${(7+r()*5).toFixed(1)}"/>`}
 $('pb').innerHTML=el(24,50,50,24,3.4,2.4);$('pbl').innerHTML=bl;$('pbu').innerHTML=bu(10,50,50,25);
 $('cbu').innerHTML=bu(9,46,50,22);$('csd').innerHTML=el(18,46,50,24,2.6,1.2);$('chb').innerHTML=el(9,46,50,23,3,1.7);$('cch').innerHTML=el(3,46,50,20,2.4,2);
})();

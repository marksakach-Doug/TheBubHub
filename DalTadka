  let q=avg*.6+weak*.4;const pens=[];
  if(c.burn>0){const bp=Math.min(50,c.burn*5);q-=bp;pens.push(['Burnt spices',bp])}
  const grp={};S.spoils.forEach(s=>{grp[s.name]=(grp[s.name]||0)+s.sp});
  Object.keys(grp).forEach(n=>{const sp=grp[n]*15;q-=sp;pens.push([n.toLowerCase().replace(/^./,x=>x.toUpperCase()),sp])});
  q=cl(q,0,100);
  const mult=Math.max(.02,q*q/10000);
  const x=cl((S.t-L.par*.5)/(L.par*2),0,1);
  const pace=Math.round(1000*Math.pow(1-x,.6)+1025*Math.pow(x,4));
  const score=Math.round((10000+pace)*mult);
  S.final=score;mark('done');document.querySelectorAll('.guide').forEach(e=>e.classList.remove('guide'));$('foot').classList.remove('hide');
  const prev=best(S.k);if(score>prev)save(S.k,score);
  const [g,gc]=grade(q);
  const TIPS={'ghee smoke':'Add ghee before the pan gets very hot.','pan fire':'Turn the pan down. An empty pan overheats fast.','boil over':'Lower the pot burner, or stir, when BOIL-OVER climbs.','stuck and scorched':'Keep water in the pot and stir when STICKING climbs.','boiled dry':'Top up the water before the pot runs dry.','spice burned':'Keep the pan under 180° once the spice is in.','burnt spices':'Keep the pan under 180° once the spice is in.'};
  const sum=a=>a.reduce((x,y)=>x+y,0),qOf=(v,pp)=>sum(v)/v.length*.6+Math.min(...v)*.4-sum(pp);
  const fv=vals.slice(),fp=pens.map(x=>x[1]),open=vals.map((v,i)=>v<85?{i}:null).filter(Boolean).concat(pens.map((_,j)=>({j}))),picks=[];
  for(let n=0;n<3&&open.length;n++){
    const base=qOf(fv,fp);let bk=-1,bg=0;
    open.forEach((o,k)=>{const v=fv.slice(),pp=fp.slice();if(o.i!==undefined)v[o.i]=90;else pp[o.j]=0;const gn=qOf(v,pp)-base;if(gn>bg){bg=gn;bk=k}});
    if(bk<0)break;
    const o=open.splice(bk,1)[0];
    if(o.i!==undefined){fv[o.i]=90;picks.push([comps[o.i][1],comps[o.i][3]])}else{fp[o.j]=0;picks.push([pens[o.j][0],TIPS[pens[o.j][0].toLowerCase()]||'Avoid this next time.'])}
  }
  const q2=cl(qOf(fv,fp),0,100),score2=Math.round((10000+pace)*Math.max(.02,q2*q2/10000)),st2=starsOf(q2),nStars=starsOf(q);
  const was=['toor','double','tadka'].map(unlocked);
  if(nStars>sBest(S.k))saveStars(S.k,nStars);
  const news=['toor','double','tadka'].filter((k,i)=>!was[i]&&unlocked(k)).map(k=>k==='tadka'?'Full tadka':LENT[k].n);
  const slow=S.t>=L.par*1.5;let secret='';
  if(slow&&nStars>=4&&!seen('found')){mark('found');mark('psst');secret='<div class="sec"><b>You found the secret.</b> Slow and careful wins.</div>'}
  else if(!slow&&nStars<=3&&!seen('psst')){mark('psst');secret='<div class="sec"><b>Psst.</b> The clock barely matters. Care does. Try one slowly.</div>'}
  const nx=(LB||[]).filter(e=>e.lentil===S.k&&+e.score>score).sort((a,b)=>a.score-b.score)[0];
  let me='';try{me=localStorage.getItem('dal:name')||''}catch(e){}
  const near=nx?(()=>{const gap=nx.score-score,who=nx.name===me?'your own score':esc(nx.name)+"'s score",pts=gap.toLocaleString();return `<div style="margin-top:8px;font-size:14px">${gap<=Math.max(300,nx.score*.2)?`You almost beat <b>${who}</b> (${(+nx.score).toLocaleString()})! Only ${pts} points to go.`:`Next score to beat: <b>${who}</b> at ${(+nx.score).toLocaleString()}.`}</div>`})():'';
  const row=(r)=>{const ok=r[2]>=80,mid=r[2]>=50,col=ok?'--good':mid?'--acc':'--bad';return `<div class="cmp" style="padding:4px 0"><span class="ic" style="color:var(${col})">${ok?'✓':mid?'~':'✗'}</span><div style="flex:1"><div style="display:flex;justify-content:space-between;font-size:13px"><b>${r[0]}${r[1]}</b><b style="color:var(${col})">${r[2].toFixed(0)}%</b></div><div class="bar" style="margin:2px 0"><b style="width:${r[2]}%;background:var(${col})"></b></div>${r[2]<85?`<div class="dim" style="font-size:12px;line-height:1.3">${r[3]}</div>`:''}</div></div>`};
  $('play').classList.add('hide');$('res').classList.remove('hide');
  $('res').innerHTML=`<h1>Taste test: ${S.title}</h1>
  <div style="text-align:center;margin:6px 0 12px"><div id="sc" style="font:700 42px ui-monospace,monospace">0</div><div id="stars" role="img" aria-label="${nStars} out of 5 stars">${STAR.repeat(5)}</div>
   <div id="verd"><div style="font:700 20px Georgia,serif;color:var(--acc);margin-top:2px">${LBL[nStars]}</div><div class="dim" style="font-size:13px;margin-top:2px">${score>prev?'New personal best!':'Your best: '+prev}</div>${near}</div></div>
  ${secret}
  ${news.length?`<div style="border:2px solid var(--good);border-radius:8px;padding:10px;margin-bottom:10px;font-size:14px"><b style="color:var(--good)">Unlocked: ${news.join(' and ')}!</b></div>`:''}
  <div style="border:2px solid var(--acc);border-radius:8px;padding:10px;margin-bottom:10px">
    ${picks.length?`<div style="font:700 14px ui-monospace,monospace">Fix ${picks.length>1?'these first':'this first'}</div><ol class="dir" style="color:var(--ink);font-size:13px;margin:6px 0">${picks.map(p=>`<li><b>${p[0]}:</b> ${p[1]}</li>`).join('')}</ol>${score2>score*1.1?`<div class="dim" style="font-size:13px">Nail ${picks.length>1?'these':'this'} and you'd score about <b style="color:var(--ink)">${score2}</b> (${st2} star${st2>1?'s':''}).</div>`:''}`:`<div style="font-size:13px">Clean run. Go faster or slower to beat it.</div>`}
  </div>
  <button class="big" data-k="${S.k}"${L.double?` data-c="${S.combo}"`:''}>TRY ${L.double?'THIS MIX':L.n.toUpperCase()} AGAIN</button>
  <button data-m="1" style="margin-top:6px">Pick a different lentil</button>
  <div id="sv" style="display:flex;gap:6px"><input type="text" id="nm" maxlength="20" placeholder="Your name" value="${esc((()=>{try{return localStorage.getItem('dal:name')||''}catch(e){return ''}})())}"><button class="ok" data-x="save" style="width:auto;padding:8px 12px;white-space:nowrap">SAVE SCORE</button></div>
  <div id="lbr" style="font-size:12px">${boardHTML(S.k,3)}</div>
  <details><summary>Full breakdown</summary>
  ${comps.map(row).join('')}
  ${pens.map(p=>`<div class="ev" style="padding:3px 0;font-size:13px"><span style="color:var(--bad)">${iWr}${p[0]}</span><b style="color:var(--bad)">-${p[1].toFixed(0)}</b></div>`).join('')}
  <div class="dim" style="font-size:12px;margin:6px 0">Quality ${q.toFixed(0)}% · ×${mult.toFixed(2)} · pacing +${pace} · ${S.t.toFixed(0)}s <button data-i="1" class="lk" style="margin-left:6px">How scoring works</button></div>
  </details>`;
  top0();reveal(score,nStars);
}

function saveScore(){
  if(S.saved)return;S.saved=true;
  const name=($('nm').value.trim()||'Anon').slice(0,20);
  try{localStorage.setItem('dal:name',name)}catch(e){}
  const en={name,lentil:S.k,score:S.final,date:new Date().toISOString().slice(0,10),...(S.L.double?{combo:S.combo.join('+')}:{}),...(S.adv?{adv:1}:{})};
  $('lbr').innerHTML=boardHTML(S.k,3);
  if(API){$('sv').innerHTML='<div class="dim" style="font-size:13px">Saving to the shared leaderboard...</div>';fetch(API+'?'+new URLSearchParams(en)).then(r=>r.json()).then(j=>{LB=j.entries||[];if(!LB.some(x=>x.name===en.name&&x.score===en.score))throw 0;if($('lbr'))$('lbr').innerHTML=boardHTML(S.k,3);$('sv').innerHTML='<div class="dim" style="font-size:13px">Saved to the shared leaderboard.</div>'}).catch(()=>{$('sv').innerHTML='<div style="color:var(--bad);font-size:13px">The shared leaderboard did not record this score. Check that the latest script is deployed as a New version with access set to Anyone.</div>'});return}
}
</script>
